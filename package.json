{
  "name": "landregistrationsystem",
  "type": "module",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "deploy:local": "hardhat run --network localhost scripts/deploy.js",
    "deploy:sepolia": "hardhat run --network sepolia scripts/deploy.js",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "backend": "cd backend && node server.js",
    "frontend": "cd frontend && npm start",
    "dev": "concurrently \"npm run node\" \"npm run backend\" \"npm run frontend\""
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "land-registry",
    "smart-contracts",
    "ipfs"
  ],
  "author": "Blockchain Developer",
  "license": "MIT",
  "description": "A complete end-to-end Blockchain-based Land Registration System with IPFS document storage and React frontend",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "hardhat": "^2.26.5",
    "hardhat-gas-reporter": "^2.3.0",
    "solidity-coverage": "^0.8.16"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "dotenv": "^17.2.3"
  }
}